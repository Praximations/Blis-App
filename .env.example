# Copy to .env.local (not committed) and fill in. Every value here ends up
# inside the app, so nothing secret belongs in this file: the Storefront
# token is Shopify's *public* one.

# The storefront's domain.
EXPO_PUBLIC_SHOPIFY_STORE_DOMAIN=blisfarms.com

# Storefront API version (Shopify releases one each quarter).
EXPO_PUBLIC_SHOPIFY_API_VERSION=2026-10

# Public Storefront access token (Shopify admin > Sales channels > Headless >
# Storefront API). Needed to know which products are "Local delivery only"
# and to read the delivery rules the Blis Delivery app publishes.
EXPO_PUBLIC_SHOPIFY_STOREFRONT_TOKEN=

# Customer Account API client id (same place > Customer Account API), for
# signing in inside the app. Without it the Account tab opens the website.
EXPO_PUBLIC_SHOPIFY_CUSTOMER_CLIENT_ID=

# The shop's numeric id (it is in the sign-in callback: shop.<id>.app://callback).
EXPO_PUBLIC_SHOPIFY_SHOP_ID=95581405551
