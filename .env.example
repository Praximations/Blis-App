# The app's settings. Copy this file to .env and fill in the two empty
# values (docs/SETUP.md, parts 2 and 3). Check them with: npm run doctor
#
# Everything here ends up inside the app, so nothing secret belongs in this
# file: the Storefront token is Shopify's *public* one, made for apps. That
# is why .env can be committed. (.env.local is for values of your own that
# you don't want to share; it is not committed and wins over .env.)

# The storefront's domain.
EXPO_PUBLIC_SHOPIFY_STORE_DOMAIN=blisfarms.com

# Storefront API version (Shopify releases one each quarter).
EXPO_PUBLIC_SHOPIFY_API_VERSION=2026-10

# Public Storefront access token (Shopify admin > Sales channels > Headless >
# your storefront > Storefront API). Needed before release: it is how the app
# knows which products are "Local delivery only".
EXPO_PUBLIC_SHOPIFY_STOREFRONT_TOKEN=

# Customer Account API client id (same storefront > Customer Account API),
# for signing in inside the app. Without it the Account tab opens the website.
EXPO_PUBLIC_SHOPIFY_CUSTOMER_CLIENT_ID=

# The shop's own number. Sign-in comes back to shop.<this>.app://callback,
# so it must match the callback address entered in Shopify.
EXPO_PUBLIC_SHOPIFY_SHOP_ID=95581405551
